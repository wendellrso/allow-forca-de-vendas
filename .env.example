# Projeto Supabase exclusivo do Allow — nunca o do STOK Studio.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon

# Exclusiva do servidor. Nunca exposta ao navegador.
SUPABASE_SERVICE_ROLE_KEY=chave-service-role

# Número que recebe os pedidos do catálogo, só dígitos, com DDD (ex.: 82999990000).
ALLOW_WHATSAPP_VENDEDORA=82999990000

# Usada pelo script scripts/db-migrate.mjs para aplicar as migrations.
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
