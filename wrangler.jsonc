// Configuração do Cloudflare Workers. O worker é gerado pelo adaptador
// OpenNext a partir do build do Next.js (npm run deploy).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allow-forca-de-vendas",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
